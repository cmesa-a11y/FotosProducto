{% comment %}
  Hello Mellow · franja de promesas (primera pantalla de la página de producto)
  Cómo usarlo (Personalizar tema > Productos > Plantilla por defecto):
  1) Arriba de todo, en la lista de secciones, toca "Agregar sección" > "Liquid personalizado".
  2) Pega TODO este código.
  3) Arrastra la sección para que quede ARRIBA de la sección del producto (justo debajo del encabezado).
  Textos editables en las 4 variables de abajo.
{% endcomment %}
{% assign hm_t1 = 'Envío gratis +$250.000' %}
{% assign hm_t2 = 'Cambios gratis' %}
{% assign hm_t3 = 'Compra segura' %}
{% assign hm_t4 = 'Express Medellín' %}
{% assign hm_t4b = '2-3 días hábiles nacional' %}

<style>
.hm-top{background:#F5F2E1;border-bottom:1px solid #eadfce}
.hm-top ul{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:0 auto;padding:8px 6px;list-style:none;max-width:1200px}
.hm-top li{display:flex;flex-direction:column;align-items:center;gap:3px;text-align:center;color:#70202c;font-size:10px;font-weight:600;line-height:1.15;text-transform:uppercase;letter-spacing:.02em}
.hm-top svg{width:20px;height:20px;stroke:#70202c;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
.hm-top small{display:block;margin-top:2px;font-size:8px;font-weight:500;text-transform:none;letter-spacing:0;opacity:.85}
@media (min-width:768px){.hm-top ul{padding:10px 16px}.hm-top li{flex-direction:row;justify-content:center;gap:8px;font-size:12px}.hm-top svg{width:24px;height:24px}.hm-top small{font-size:10px}}
</style>
<div class="hm-top">
  <ul>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6.5h11v9H2z"/><path d="M13 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/></svg><span>{{ hm_t1 }}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4.5h4.5"/><path d="M9 12.2l2 2 4-4"/></svg><span>{{ hm_t2 }}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M8.8 12l2.4 2.4 4-4.4"/></svg><span>{{ hm_t3 }}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13.5h6L10 21l8-10.5h-6z"/></svg><span>{{ hm_t4 }}<small>{{ hm_t4b }}</small></span></li>
  </ul>
</div>

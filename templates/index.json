        "custom_liquid": "<style>\n  .lm-valores{background:#fff;border-top:.5px solid #E8E2D8;border-bottom:.5px solid #E8E2D8;padding:0 20px}\n  .lm-valores__in{display:flex;max-width:760px;margin:0 auto}\n  .lm-valor{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:20px 8px;position:relative}\n  .lm-valor+.lm-valor:before{content:\"\";position:absolute;left:0;top:20%;height:60%;width:.5px;background:#E8E2D8}\n  .lm-valor__ico{width:40px;height:40px;border-radius:50%;background:#F2EDE3;border:.5px solid #D8CEBC;display:flex;align-items:center;justify-content:center}\n  .lm-valor__tx{font-size:11px;font-weight:700;color:#5A6B54;text-align:center;letter-spacing:.08em;text-transform:uppercase}\n  @media (min-width:750px){ .lm-valores__in{max-width:900px} .lm-valor{padding:26px 8px} .lm-valor__tx{font-size:12px} }\n</style>\n<div class=\"lm-valores\"><div class=\"lm-valores__in\">\n  <div class=\"lm-valor\"><span class=\"lm-valor__ico\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#5A6B54\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M6.5 8.5c-2 0-3.5 1.6-3.5 3.5s1.5 3.5 3.5 3.5c3.5 0 4.5-7 8-7 2 0 3.5 1.6 3.5 3.5S20.5 15.5 18.5 15.5c-3.5 0-4.5-7-8-7Z\"/></svg></span><span class=\"lm-valor__tx\">Sin género</span></div>\n  <div class=\"lm-valor\"><span class=\"lm-valor__ico\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#5A6B54\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 20c0-8 5-14 16-15 0 10-5 15-12 15H4Z\"/><path d=\"M8 18c2-4 5-7 9-9\"/></svg></span><span class=\"lm-valor__tx\">Circular</span></div>\n  <div class=\"lm-valor\"><span class=\"lm-valor__ico\"><svg viewBox=\"0 0 24 16\" width=\"22\" height=\"15\" aria-hidden=\"true\"><rect width=\"24\" height=\"8\" fill=\"#FCD116\"/><rect y=\"8\" width=\"24\" height=\"4\" fill=\"#003893\"/><rect y=\"12\" width=\"24\" height=\"4\" fill=\"#CE1126\"/></svg></span><
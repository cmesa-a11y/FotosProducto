    "custom_liquid_N3GbXi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .lm-pasos{background:#F0EDE6;padding:36px 20px;text-align:center;font-family:inherit}\n  .lm-pasos__t{font-size:15px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#8B7E6A;margin:0 0 28px}\n  .lm-pasos__grid{display:grid;grid-template-columns:1fr;gap:18px;max-width:480px;margin:0 auto}\n  .lm-paso{display:flex;align-items:flex-start;gap:12px;text-align:left}\n  .lm-paso__n{flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#2C2A26;color:#fff;font-size:12px;font-weight:600;line-height:28px;text-align:center}\n  .lm-paso__h{font-size:15px;font-weight:600;color:#2C2A26;margin:0 0 3px}\n  .lm-paso__p{font-size:14px;color:#7A7060;margin:0}\n  .lm-pasos__cta{display:inline-block;margin-top:26px;border:1px solid #C4B99A;color:#8B7E6A;padding:10px 22px;border-radius:4px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none}\n  .lm-pasos__cta:hover{background:#C4B99A;color:#fff}\n  @media (min-width:750px){\n    .lm-pasos{padding:56px 20px}\n    .lm-pasos__grid{grid-template-columns:repeat(3,1fr);gap:32px;max-width:1000px}\n    .lm-paso{flex-direction:column;align-items:center;text-align:center;gap:14px}\n  }\n</style>\n<div class=\"lm-pasos\">\n  <p class=\"lm-pasos__t\">¿Cómo funciona el bordado?</p>\n  <div class=\"lm-pasos__grid\">\n    <div class=\"lm-paso\"><div class=\"lm-paso__n\">1</div><div>\n      <p class=\"lm-paso__h\">Elige la prenda y el color</p>\n      <p class=\"lm-paso__p\">Babero o muselina disponibles en varios tonos</p></div></div>\n    <div class=\"lm-paso\"><div class=\"lm-paso__n\">2</div><div>\n      <p class=\"lm-paso__h\">Configura el bordado</p>\n      <p class=\"lm-paso__p\">Nombre · 7 tipografías · 6 colores de hilo</p></div></div>\n    <div class=\"lm-paso\"><div class=\"lm-paso__n\">3</div><div>\n      <p class=\"lm-paso__h\">Recíbela en 3–5 días</p>\n      <p class=\"lm-paso__p\">Bordado listo para regalar o estrenar</p></div></div>\n  </div>\n  <a href=\"https://drive.google.com/file/d/1aC64bvKFZIhLWIrEAo3zSdwPzYXo8TvH/preview\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"lm-pasos__cta\">Ver guía de tipografías e hilos</a>\n</div>"
      }
    },
